# Copy to terraform.tfvars and edit.

label         = "linode-spike"
region        = "us-ord"
instance_type = "g6-standard-2"

# cat ~/.ssh/id_ed25519.pub
authorized_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@example.com",
]

# Your current public IP: curl -s ifconfig.me
# Locks SSH and the Coolify dashboard to you. 80/443 stay public.
admin_ipv4_cidrs = ["203.0.113.4/32"]

attach_data_volume = false
