# Local development (docker-compose.yml reads these)
POSTGRES_USER=app
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=app
DATABASE_URL=postgres://app:devpassword@db:5432/app

APP_PORT=3000
# Host-side port for the dev database. Not 5432 — that collides with a
# Postgres installed directly on your machine.
POSTGRES_HOST_PORT=55432
NODE_ENV=development
GREETING=Hello from the dev container

# --- mailhook (Microsoft 365 -> bucket -> Postgres queue) -----------------
# Locally the service talks to MinIO and accepts .eml files on /dev/ingest, so
# none of the Graph settings are needed to try the pipeline out.
MAILHOOK_PORT=3001
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=mailhook-archive
S3_REGION=us-ord-1

# Shared secret Graph echoes back on every notification. Generate a real one
# for anything public: openssl rand -hex 32
WEBHOOK_CLIENT_STATE=local-dev-client-state

# Public HTTPS base URL Graph calls. Only needed once you subscribe for real —
# Coolify assigns this when you give the mailhook service a domain.
# WEBHOOK_PUBLIC_URL=https://mailhook.example.com

# Entra ID app registration with the Mail.Read *application* permission,
# admin-consented and scoped with an application access policy.
# GRAPH_TENANT_ID=...
# GRAPH_CLIENT_ID=...
# GRAPH_CLIENT_SECRET=...
# GRAPH_MAILBOX=invoices@contoso.com

# Terraform / Linode — export in your host shell, not committed
# LINODE_TOKEN=...
